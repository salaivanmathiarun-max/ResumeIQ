# ==============================================================================
# ResumeIQ Backend Environment Configuration Template
# Copy this file to .env in the backend directory and configure your credentials.
# ==============================================================================

# Google Gemini API Key (Required for AI semantic analysis)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name (Optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Allowed CORS Origins (Optional, comma-separated list of origins)
# In production, set to your frontend domain (e.g., https://resumeiq.vercel.app)
# Defaults to: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection URL (Optional, defaults to local SQLite at backend/resumeiq.db)
# For persistent container volumes: sqlite+pysqlite:////data/resumeiq.db?check_same_thread=False
# For PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=

# SQLite Custom Database Path (Optional, alternative to DATABASE_URL for volume mounts)
# Example: /data/resumeiq.db
SQLITE_DB_PATH=

# Upload Storage Directory (Optional, defaults to backend/uploads)
# For persistent container volumes, set to your mount point, e.g., /data/uploads
RESUMEIQ_UPLOAD_DIR=uploads

# Maximum File Upload Size in Bytes (Optional, defaults to 5 MB: 5242880)
MAX_FILE_SIZE_BYTES=5242880
